# Copia este archivo como ai-service/.env y completa los valores. El .env real NO se sube a Git.

# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini. Si da 404 o timeout, lista los disponibles para tu clave (ver README).
GEMINI_MODEL=gemini-3.5-flash-lite

# Orígenes que pueden llamar al servicio, separados por comas (agrega la URL de Firebase Hosting).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Topes de consumo: por conversación, por usuario (o IP) al día y global al día (protege la cuota de Gemini).
MAX_MESSAGES_PER_SESSION=20
MAX_MESSAGES_PER_DAY=100
MAX_GLOBAL_MESSAGES_PER_DAY=1000

# Opcional: si se definen, /chat exige una sesión válida de MatchPet (recomendado fuera de desarrollo).
SUPABASE_URL=
SUPABASE_ANON_KEY=
